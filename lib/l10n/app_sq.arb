  "settingsPrivacyPolicy": "Politika e privatësisë",
  "settingsPrivacyOpenFailed": "Politika e privatësisë nuk u hap.",
  "hadith53": "“Mos e nënvlerëso asnjë vepër të mirë, qoftë edhe ta takosh vëllanë tënd me fytyrë të qeshur.”\n— Muslimi",
  "hadith54": "“Më i miri prej jush është ai që është më i mirë me familjen e tij.”\n— Tirmidhiu",
  "hadith55": "“Kush i lexon natën dy ajetet e fundit të sures El-Bekare, ato i mjaftojnë.”\n— Buhariu dhe Muslimi",
  "hadith56": "“Dunjaja është kënaqësi, dhe kënaqësia më e mirë e saj është gruaja e devotshme.”\n— Muslimi",
  "hadith57": "“Tri lutje nuk refuzohen kurrë: lutja e agjëruesit, e udhëheqësit të drejtë dhe e të shtypurit.”\n— Tirmidhiu",
  "hadith58": "“Kush dërgon salavat mbi mua një herë, Allahu dërgon dhjetë herë mëshirë mbi të.”\n— Muslimi",
  "hadith65": "“Besimtari është pasqyra e besimtarit.”\n— Ebu Davudi",
  "hadith66": "“Sinqeriteti të çon në mirësi, e mirësia të çon në Xhenet.”\n— Buhariu dhe Muslimi",
  "hadith67": "“Ktheja amanetin atij që ta la në amanet dhe mos e tradhto atë që të tradhtoi.”\n— Ebu Davudi dhe Tirmidhiu",
  "hadith68": "“Muslimanin nuk e godet asnjë lodhje, sëmundje, brengë, trishtim, lëndim apo shqetësim, madje as gjembi që e shpon, e që Allahu të mos ia shlyejë me të disa nga mëkatet.”\n— Buhariu dhe Muslimi",
  "hadith69": "“Lutja e muslimanit për vëllanë e tij në mungesë të tij pranohet gjithmonë.”\n— Muslimi",
  "hadith70": "“Kush i kërkon Allahut Xhenetin tri herë, Xheneti thotë: O Allah, fute atë në Xhenet.”\n— Tirmidhiu",
  "hadith71": "“Agjërimi më i vlefshëm pas Ramazanit është agjërimi i muajit të Allahut, Muharremit.”\n— Muslimi",
  "hadith72": "“Kush kryen haxhin dhe nuk flet fjalë të ndyta e nuk bën mëkat, kthehet si ditën kur e lindi nëna e tij.”\n— Buhariu dhe Muslimi",
  "hadith73": "“Umra deri në umrën tjetër është shlyerje për mëkatet mes tyre.”\n— Buhariu dhe Muslimi",
  "hadith74": "“Nxitoni drejt veprave të mira para se të vijnë sprova si copat e natës së errët.”\n— Muslimi",
  "hadith75": "“Dy rekatet e sabahut janë më të mira se bota dhe gjithçka që gjendet në të.”\n— Muslimi",
  "hadith77": "“Nëse do të mbështeteshit tek Allahu siç duhet, Ai do t'ju furnizonte ashtu siç i furnizon shpendët.”\n— Tirmidhiu",
  "hadith78": "“Kush viziton një të sëmurë, është në vjeljen e frutave të Xhenetit derisa të kthehet.”\n— Muslimi",
  "hadith79": "“Përhapni selamin, ushqeni të uriturit dhe faluni natën kur njerëzit flenë — do të hyni në Xhenet në paqe.”\n— Tirmidhiu",
  "hadith80": "“Kush nuk është mirënjohës ndaj njerëzve, nuk është mirënjohës ndaj Allahut.”\n— Tirmidhiu",
  "hadith81": "“Smira nuk lejohet përveçse në dy raste: te njeriu të cilit Allahu i ka dhënë pasuri dhe ai e shpenzon në rrugë të drejtë, dhe te njeriu të cilit Allahu i ka dhënë urtësi dhe ai gjykon me të dhe ua mëson të tjerëve.”\n— Buhariu dhe Muslimi",
  "hadith82": "“Njeriu është në fenë e mikut të tij, prandaj le të shikojë secili prej jush me kë miqësohet.”\n— Ebu Davudi dhe Tirmidhiu",
  "hadith85": "“Kush lë diçka për hir të Allahut, Allahu e zëvendëson me diçka më të mirë.”\n— Ahmedi",
  "hadith86": "“Kush ia mbulon të metat një muslimani, Allahu do t'ia mbulojë të metat në Ditën e Kiametit.”\n— Buhariu dhe Muslimi",
  "hadith87": "“Ji në këtë botë sikur të ishe i huaj ose udhëtar.”\n— Buhariu",
  "hadith88": "“Kush ia lehtëson dikujt që është në vështirësi, Allahu do t'ia lehtësojë atij në dynja dhe në ahiret.”\n— Muslimi",
  "hadith89": "“Shpërblimi i veprave varet nga nijetet.”\n— Buhariu dhe Muslimi",
  "hadith90": "“Ruhuni nga dyshimi, sepse dyshimi është fjala më gënjeshtare.”\n— Buhariu dhe Muslimi",
  "hadith93": "“Hani së bashku dhe përmendni emrin e Allahut, që t'ju jepet bereqet në të.”\n— Ebu Davudi",
  "hadith94": "“Sa herë që njerëz ulen duke përmendur Allahun, melekët i rrethojnë, mëshira i mbulon dhe qetësia zbret mbi ta.”\n— Muslimi",
  "hadith95": "“Robit që fal, Allahu nuk i shton gjë tjetër përveç nderit.”\n— Muslimi",
  "hadith96": "“Lidhe devenë tënde e pastaj mbështetu tek Allahu.”\n— Tirmidhiu",
  "hadith97": "“Sa e mahnitshme është puna e besimtarit — gjithçka është në të mirë të tij.”\n— Muslimi",
  "hadith98": "“Muslimani është vëlla i muslimanit: nuk i bën padrejtësi, nuk e braktis dhe nuk e përbuz.”\n— Muslimi",
  "hadith20": "“Kush agjëron Ramazanin me besim dhe duke shpresuar shpërblimin, i falen mëkatet e kaluara.”\n— Buhariu dhe Muslimi",
  "hadith22": "“Lutja midis ezanit dhe ikametit nuk refuzohet.”\n— Ebu Davudi",
  "hadith23": "“Kush ndërton një xhami për Allahun, Allahu i ndërton atij një shtëpi në Xhenet.”\n— Buhariu dhe Muslimi",
  "hadith24": "“Safet më të mira për burrat janë të parat, kurse për gratë janë të fundit.”\n— Muslimi",
  "hadith25": "“Agjërimi është mburojë nga zjarri i Xhehenemit.”\n— Nesaiu",
  "hadith26": "“Kush fal dymbëdhjetë rekate sunet, i ndërtohet një shtëpi në Xhenet.”\n— Muslimi",
  "hadith27": "“Ai që e lexon Kuranin me mjeshtëri do të jetë me melekët fisnikë.”\n— Buhariu dhe Muslimi",
  "hadith29": "“Sadakaja më e mirë është t'u japësh ujë të pinë.”\n— Ahmedi",
  "hadith30": "“Kush ia largon besimtarit një vështirësi, Allahu do t'ia largojë atij një vështirësi në Ditën e Kiametit.”\n— Muslimi",
  "hadith32": "“Turpi është pjesë e besimit.”\n— Buhariu dhe Muslimi",
  "hadith34": "“Kush duron, Allahu i jep durim.”\n— Buhariu dhe Muslimi",
  "hadith36": "“Askush prej jush nuk beson vërtet derisa t'i dojë vëllait të vet atë që i do vetes.”\n— Buhariu dhe Muslimi",
  "hadith37": "“Ushqeni të uriturit, vizitoni të sëmurët dhe lironi të robëruarit.”\n— Buhariu",
  "hadith38": "“I forti nuk është ai që mund në mundje, por ai që e kontrollon veten në zemërim.”\n— Buhariu dhe Muslimi",
  "hadith40": "“Thoni ‘Subhanallah’, ‘Elhamdulilah’ dhe ‘Allahu Ekber’ nga tridhjetë e tri herë pas çdo namazi.”\n— Muslimi",
  "hadith41": "“Dhikri më i mirë është La ilahe il-lallah.”\n— Tirmidhiu",
  "hadith42": "“Ka dy nimete që shumë njerëz i humbasin: shëndetin dhe kohën e lirë.”\n— Buhariu",
  "hadith43": "“Përfitoni pesë gjëra para pesë të tjerave: rininë para pleqërisë, shëndetin para sëmundjes, pasurinë para varfërisë, kohën e lirë para zënies me punë dhe jetën para vdekjes.”\n— Hakimi",
  "hadith44": "“Kush e lexon suren El-Ihlas dhjetë herë, Allahu i ndërton një shtëpi në Xhenet.”\n— Ahmedi",
  "hadith45": "“Namazi më i mirë pas namazeve farz është namazi i natës.”\n— Muslimi",
  "hadith46": "“Sadakaja i shuan mëkatet siç e shuan uji zjarrin.”\n— Tirmidhiu",
  "hadith47": "“Ai që i mban lidhjet farefisnore nuk është ai që i kthen vizitat, por ai që i mban edhe kur i shkëputen.”\n— Buhariu",
  "hadith49": "“Kush ha ushqim dhe thotë: ‘Falënderimi i takon Allahut, që më ushqeu me këtë dhe ma dha pa asnjë fuqi e forcë nga ana ime’, i falen mëkatet e kaluara.”\n— Tirmidhiu",
