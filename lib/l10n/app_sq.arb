  "settingsRolloverSub": "Kur nis dita e re",
  "hadith10": "“Kush thotë ‘Subhanallahi ue bihamdihi’ njëqind herë në ditë, i falen mëkatet, edhe sikur të jenë sa shkuma e detit.”\n— Buhariu dhe Muslimi",
  "hadith12": "“Kush lexon Ajetul-Kursijj pas çdo namazi farz, asgjë nuk e pengon të hyjë në Xhenet përveç vdekjes.”\n— Nesaiu",
  "hadith13": "“Fjala e mirë është sadaka.”\n— Buhariu dhe Muslimi",
  "hadith14": "“Kush beson në Allahun dhe Ditën e Fundit, le të thotë fjalë të mirë ose le të heshtë.”\n— Buhariu dhe Muslimi",
  "hadith15": "“Ai që kujdeset për të vejën ose për të varfrin është si ai që lufton në rrugën e Allahut.”\n— Buhariu dhe Muslimi",
  "hadith16": "“Buzëqeshja ndaj vëllait tënd është sadaka.”\n— Tirmidhiu",
  "hadith17": "“Më i miri prej jush është ai që e mëson Kuranin dhe ua mëson të tjerëve.”\n— Buhariu",
  "hadith18": "“Askush nuk ka ngrënë ushqim më të mirë sesa atë që e fiton me punën e duarve të veta.”\n— Buhariu",
  "hadith19": "“Allahu është i butë dhe e do butësinë në çdo gjë.”\n— Buhariu dhe Muslimi",
  "settingsAbout": "Rreth aplikacionit",
  "settingsVersion": "Versioni",
  "settingsDeveloper": "Zhvilluesi",
  "settingsSupport": "Mbështetje",
