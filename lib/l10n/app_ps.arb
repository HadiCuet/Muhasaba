  "settingsRequestFeature": "د نوې ځانګړنې غوښتنه وکړئ",
  "settingsSupportFallback": "بریښنالیک پرانیستل نه شو. مهرباني وکړئ {email} ته بریښنالیک ولېږئ.",
  "settingsPrivacyPolicy": "د محرمیت تګلاره",
  "settingsPrivacyOpenFailed": "د محرمیت تګلاره نه شوه پرانیستل.",
  "hadith53": "«هېڅ نېکي مه سپکه ګڼئ، که څه هم دا وي چې له خپل ورور سره په ورین تندي مخ شئ.»\n— مسلم",
  "hadith54": "«ستاسو تر ټولو غوره هغه څوک دی چې له خپلې کورنۍ سره تر ټولو ښه وي.»\n— ترمذي",
  "hadith55": "«څوک چې د شپې د سورة البقرة وروستي دوه آیتونه ولولي، هغه ورته بس دي.»\n— بخاري او مسلم",
  "hadith56": "«دنیا متاع ده، او د دنیا تر ټولو غوره متاع نېکه ښځه ده.»\n— مسلم",
  "hadith57": "«درې دعاګانې نه ردېږي: د روژه دار دعا، د عادل واکمن دعا، او د مظلوم دعا.»\n— ترمذي",
  "hadith58": "«څوک چې پر ما یو ځل درود ووايي، الله به پرې لس ځله رحمت ولېږي.»\n— مسلم",
  "hadith65": "«مؤمن د مؤمن آینه دی.»\n— ابو داود",
  "hadith66": "«رښتیا نېکۍ ته لار ښيي، او نېکي جنت ته لار ښيي.»\n— بخاري او مسلم",
  "hadith67": "«امانت هغه چا ته وسپاره چې تا ته یې سپارلی دی، او له هغه چا سره خیانت مه کوه چې له تا سره یې خیانت کړی وي.»\n— ابو داود او ترمذي",
  "hadith68": "«مسلمان ته هېڅ ستړیا، ناروغي، غم، خپګان، ازار او پرېشاني نه رسېږي، حتی د اغزي چوخېدل هم، مګر دا چې الله په هغې سره د هغه ځینې ګناهونه معاف کړي.»\n— بخاري او مسلم",
  "hadith69": "«د خپل ورور په غیاب کې د مسلمان دعا د هغه لپاره قبلېږي.»\n— مسلم",
  "hadith70": "«څوک چې له الله څخه درې ځله جنت وغواړي، جنت وايي: ای الله، دی جنت ته داخل کړه.»\n— ترمذي",
  "hadith71": "«له رمضان وروسته تر ټولو غوره روژه د الله د میاشتې، محرم، روژه ده.»\n— مسلم",
  "hadith72": "«څوک چې حج وکړي او بې‌حیايي او ګناه ونه کړي، هغه داسې بېرته راګرځي لکه هغه ورځ چې مور زېږولی و.»\n— بخاري او مسلم",
  "hadith73": "«یوه عمره تر بلې عمرې پورې د دواړو ترمنځ ګناهونو کفاره ده.»\n— بخاري او مسلم",
  "hadith74": "«مخکې له دې چې فتنې د تورې شپې د ټوټو په څېر راشي، په نېکو عملونو کې بیړه وکړئ.»\n— مسلم",
  "hadith75": "«د فجر دوه رکعته له دنیا او هر هغه څه چې پکې دي غوره دي.»\n— مسلم",
  "hadith77": "«که تاسو پر الله داسې توکل وکړئ لکه چې د توکل حق یې دی، نو تاسو ته به داسې روزي درکړي لکه مرغانو ته یې چې ورکوي.»\n— ترمذي",
  "hadith78": "«څوک چې د ناروغ پوښتنې ته ورشي، تر بېرته راګرځېدو پورې د جنت د مېوو په ټولولو کې وي.»\n— مسلم",
  "hadith79": "«سلام خپور کړئ، وږو ته خوراک ورکړئ، او د شپې لمونځ وکړئ کله چې خلک ویده وي — په سلامتۍ سره به جنت ته ننوځئ.»\n— ترمذي",
  "hadith80": "«څوک چې د خلکو شکر نه باسي، د الله شکر هم نه باسي.»\n— ترمذي",
  "hadith81": "«حسد یوازې په دوو حالتونو کې روا دی: هغه سړی چې الله ورته مال ورکړی وي او هغه یې په حقه لاره کې لګوي، او هغه سړی چې الله ورته حکمت ورکړی وي او هغه پرې فیصله کوي او نورو ته یې ښيي.»\n— بخاري او مسلم",
  "hadith82": "«انسان د خپل نږدې ملګري پر دین وي، نو هر یو مو دې وګوري چې له چا سره ملګرتیا کوي.»\n— ابو داود او ترمذي",
  "hadith85": "«څوک چې د الله لپاره یو شی پرېږدي، الله به یې ورته په غوره شي بدل کړي.»\n— احمد",
  "hadith86": "«هر څوک چې د مسلمان عیبونه پټ کړي، الله به د قیامت په ورځ د هغه عیبونه پټ کړي.»\n— بخاري او مسلم",
  "hadith87": "«په دنیا کې داسې اوسه لکه پردی یا لاروی.»\n— بخاري",
  "hadith88": "«څوک چې پر یوه کړېدلي اسانتیا وکړي، الله به پر هغه په دنیا او آخرت کې اسانتیا وکړي.»\n— مسلم",
  "hadith89": "«عملونه د نیتونو پورې تړلي دي.»\n— بخاري او مسلم",
  "hadith90": "«له بدګمانۍ څخه ځان ساتئ، ځکه چې بدګماني تر ټولو دروغجنه خبره ده.»\n— بخاري او مسلم",
  "hadith93": "«یوځای خوراک وکړئ او د الله نوم واخلئ، نو ستاسو لپاره به برکت وي.»\n— ابو داود",
  "hadith94": "«هېڅ قوم د الله د ذکر لپاره نه کېني، مګر دا چې پرښتې یې راګیر کړي، رحمت یې ونغاړي، او سکینه پرې نازله شي.»\n— مسلم",
  "hadith95": "«الله بنده ته د بخښنې له امله یوازې عزت ور زیاتوي.»\n— مسلم",
  "hadith96": "«خپل اوښ وتړه بیا په الله توکل وکړه.»\n— ترمذي",
  "hadith97": "«د مؤمن کار عجیب دی — هر څه ورته ښه دي.»\n— مسلم",
  "hadith98": "«مسلمان د مسلمان ورور دی: نه پرې ظلم کوي، نه یې بې‌مرستې پرېږدي، او نه یې سپکوي.»\n— مسلم",
  "hadith20": "«څوک چې د ایمان او د ثواب په هیله د رمضان روژه ونیسي، مخکیني ګناهونه یې بخښل کېږي.»\n— بخاري او مسلم",
  "hadith22": "«د اذان او اقامت ترمنځ دعا رد نه کېږي.»\n— ابو داود",
  "hadith23": "«هر څوک چې د الله لپاره جومات جوړ کړي، الله به ورته په جنت کې کور جوړ کړي.»\n— بخاري او مسلم",
  "hadith24": "«د نارینه وو لپاره غوره صفونه لومړي صفونه دي، او د ښځو لپاره غوره صفونه وروستي صفونه دي.»\n— مسلم",
  "hadith25": "«روژه د دوزخ له اور څخه ډال دی.»\n— نسائي",
  "hadith26": "«هر څوک چې دولس رکعته سنت لمونځ وکړي، ورته به په جنت کې کور جوړ شي.»\n— مسلم",
  "hadith27": "«هغه څوک چې په قرآن کې ماهر وي، له عزتمنو او نېکو پرښتو سره به وي.»\n— بخاري او مسلم",
  "hadith29": "«تر ټولو غوره صدقه اوبه څښول دي.»\n— احمد",
  "hadith30": "«څوک چې له مؤمن څخه یوه سختي لرې کړي، الله به د قیامت په ورځ له هغه څخه یوه سختي لرې کړي.»\n— مسلم",
  "hadith32": "«حیا د ایمان برخه ده.»\n— بخاري او مسلم",
  "hadith34": "«هر څوک چې صبر وکړي، الله به ورته صبر ورکړي.»\n— بخاري او مسلم",
  "hadith36": "«له تاسو څخه هېڅوک تر هغه پوره مؤمن نه شي، تر څو چې خپل ورور ته هغه څه خوښ نه کړي چې ځان ته یې خوښوي.»\n— بخاري او مسلم",
  "hadith37": "«وږي ته خوراک ورکړئ، د ناروغ پوښتنه وکړئ، او بندیان آزاد کړئ.»\n— بخاري",
  "hadith38": "«پیاوړی هغه نه دی چې په غېږ نیولو کې بل وغورځوي، بلکې پیاوړی هغه دی چې د غوسې پر مهال ځان کنټرول کړي.»\n— بخاري او مسلم",
  "hadith40": "«د هر لمانځه وروسته درې دېرش ځله «سبحان الله»، «الحمد لله» او «الله اکبر» ووایئ.»\n— مسلم",
  "hadith41": "«غوره ذکر «لا اله الا الله» دی.»\n— ترمذي",
  "hadith42": "«دوه نعمتونه شته چې ډېری خلک یې ضایع کوي: روغتیا او خالي وخت.»\n— بخاري",
  "hadith43": "«پنځه شیان له پنځو مخکې غنیمت وګڼئ: ځواني له زوړتیا مخکې، روغتیا له ناروغۍ مخکې، شتمني له بې‌وزلۍ مخکې، وزګار وخت له بوختیا مخکې، او ژوند له مرګ مخکې.»\n— حاکم",
  "hadith44": "«څوک چې سوره اخلاص لس ځله ولولي، الله به ورته په جنت کې کور جوړ کړي.»\n— احمد",
  "hadith45": "«له فرض لمونځونو وروسته تر ټولو غوره لمونځ د شپې لمونځ دی.»\n— مسلم",
  "hadith46": "«صدقه ګناهونه داسې مړ کوي لکه اوبه چې اور مړ کوي.»\n— ترمذي",
  "hadith47": "«صله رحمي کوونکی هغه نه دی چې بدله ورکوي، بلکې هغه دی چې کله ترې خپلوي پرې شي، بیا یې هم پالي.»\n— بخاري",
  "hadith49": "«څوک چې خوراک وخوري او ووايي: «ټوله ستاینه هغه الله ته ده چې دا خوراک یې راکړ او زما له ځواک او قوت پرته یې روزي کړ»، مخکیني ګناهونه یې بخښل کېږي.»\n— ترمذي",
