  "hadith0": "«الله تعالی ته تر ټولو خوښ عملونه هغه دي چې په دوام سره وشي، که څه هم لږ وي.»\n— بخاري او مسلم",
  "hadith2": "«کله چې د آدم زوی مړ شي، عمل یې پرې کېږي پرته له دریو شیانو: صدقه جاریه، ګټور علم، یا نېک اولاد چې ورته دعا کوي.»\n— مسلم",
  "hadith3": "«څوک چې دوه سړه لمونځونه (فجر او عصر) وکړي، جنت ته به ننوځي.»\n— بخاري",
  "hadith4": "«الله ستاسو بڼه او شتمنۍ ته نه ګوري، بلکې ستاسو زړونو او عملونو ته ګوري.»\n— مسلم",
  "hadith6": "«اسانی کوئ او سختي مه کوئ، زېری ورکوئ او خلک مه تښتوئ.»\n— بخاري",
  "hadith7": "«څوک چې د علم په لټه کې په یوه لاره روان شي، الله به ورته د جنت لاره اسانه کړي.»\n— مسلم",
  "hadith8": "«صدقه مال نه کموي.»\n— مسلم",
  "hadith9": "«قوي مؤمن له کمزوري مؤمن څخه غوره او الله ته ډېر خوښ دی، او په دواړو کې خیر شته.»\n— مسلم",
  "historyDayCompleted": "د {total} څخه {completed} بشپړ شوي",
