  "hadith53": "\"Hiç bir ýagşylygy kiçi görme, hatda doganyň bilen güler ýüz bilen duşuşmak bolsa-da.\"\n— Muslim",
  "hadith54": "\"Siziň iň gowuňyz maşgalasyna iň gowy garaýanyňyzdyr.\"\n— Tirmizi",
  "hadith55": "\"Kim gije Bakara süresiniň soňky iki aýatyny okasa, olar oňa ýeterlik bolar.\"\n— Buhary we Muslim",
  "hadith56": "\"Dünýä peýdalanylýan nygmatdyr, onuň iň haýyrlysy salyha aýaldyr.\"\n— Muslim",
  "hadith57": "\"Üç doga ret edilmez: oraza tutýanyň dogasy, adalatly ýolbaşçynyň dogasy we mazlumyň dogasy.\"\n— Tirmizi",
  "hadith58": "\"Kim maňa bir gezek salawat aýtsa, Alla oňa on gezek rehmet iberer.\"\n— Muslim",
  "hadith65": "\"Mömin möminiň aýnasydyr.\"\n— Abu Dawud",
  "hadith66": "\"Dogruçyllyk ýagşylyga eltýär, ýagşylyk bolsa jennete eltýär.\"\n— Buhary we Muslim",
  "hadith67": "\"Amanaty saňa ynanana gaýtar, saňa hyýanat edene hyýanat etme.\"\n— Abu Dawud we Tirmizi",
  "hadith68": "\"Musulmana ýetýän ýadawlyk, kesel, gaýgy, hasrat, azar ýa-da alada, hatda oňa batan tiken üçin hem Alla onuň käbir günälerini öçürer.\"\n— Buhary we Muslim",
  "hadith69": "\"Musulmanyň doganyna gaýybana eden dogasy hemişe kabul bolýar.\"\n— Muslim",
  "hadith70": "\"Kim Alladan üç gezek jennet sorasa, jennet: «Allahym, ony jennete girizgin» diýer.\"\n— Tirmizi",
  "hadith71": "\"Ramazandan soňky iň fazylatly oraza Allanyň aýy Muharremde tutulýan orazadyr.\"\n— Muslim",
  "hadith72": "\"Kim haj edip, edepsiz söz aýtmasa we günä etmese, ejesinden doglan günündäki ýaly bolup gaýdyp geler.\"\n— Buhary we Muslim",
  "hadith73": "\"Umra indiki umra çenli arasyndaky günäleriň keffaratydyr.\"\n— Buhary we Muslim",
  "hadith74": "\"Garaňky gijäniň bölekleri ýaly pitneler gelmänkä ýagşy amallara howlugyň.\"\n— Muslim",
  "hadith75": "\"Bamdat namazynyň iki rekagaty dünýäden we ondaky ähli zatdan gowudyr.\"\n— Muslim",
  "hadith77": "\"Eger siz Alla hakyky tewekkül etmeli derejede tewekkül etseňiz, Ol guşlary rysgallandyryşy ýaly sizi hem rysgallandyrardy.\"\n— Tirmizi",
  "hadith78": "\"Kim syrkawa baryp görse, gaýdýança jennet bagynda bolar.\"\n— Muslim",
  "hadith79": "\"Salamy ýaýradyň, nahar beriň we adamlar ýatyrka gije namaz okaň — jennete salamatlyk bilen girersiňiz.\"\n— Tirmizi",
  "hadith80": "\"Adamlara şükür etmeýän, Allaha-da şükür etmez.\"\n— Tirmizi",
  "hadith81": "\"Göriplik diňe iki ýagdaýda jaýyzdyr: Alla baýlyk beren we ony hak ýolda sarp edýän adama, Alla hikmet beren we onuň bilen höküm edip, ony öwredýän adama.\"\n— Buhary we Muslim",
  "hadith82": "\"Adam dostunyň dinindedir, şonuň üçin her biriňiz kimi dost tutýandygyna seretsin.\"\n— Abu Dawud we Tirmizi",
  "hadith85": "\"Kim Alla üçin bir zady taşlasa, Alla oňa ondan gowusyny berer.\"\n— Ahmad",
  "hadith86": "\"Kim musulmanyň aýbyny gizlese, Alla Kyýamat gününde onuň aýbyny gizlär.\"\n— Buhary we Muslim",
  "hadith87": "\"Dünýäde ýat adam ýa-da ýolagçy ýaly bol.\"\n— Buhary",
  "hadith88": "\"Kim kynçylykdaky adama aňsatlyk etse, Alla oňa dünýäde we ahyretde aňsatlyk eder.\"\n— Muslim",
  "hadith89": "\"Amallaryň sylagy niýetlere baglydyr.\"\n— Buhary we Muslim",
  "hadith90": "\"Gümandan gaça duruň, sebäbi güman iň ýalan sözdür.\"\n— Buhary we Muslim",
  "hadith93": "\"Bile nahar iýiň we Allanyň adyny tutuň, şonda ol size bereketli bolar.\"\n— Abu Dawud",
  "hadith94": "\"Allany ýatlap oturan adamlary perişdeler gurşap alýar, rahmet olary örtýär we olaryň üstüne rahatlyk iner.\"\n— Muslim",
  "hadith95": "\"Alla bagyşlaýan gulunyň diňe hormatyny artdyrar.\"\n— Muslim",
  "hadith96": "\"Düýäňi daň, soňra Alla tewekkül et.\"\n— Tirmizi",
  "hadith97": "\"Möminiň işi nähili täsin — onuň her bir işi özi üçin haýyrdyr.\"\n— Muslim",
  "hadith98": "\"Musulman musulmanyň doganydyr: oňa zulum etmez, taşlamaz, äsgermezlik etmez.\"\n— Muslim",
  "hadith20": "\"Kim Ramazan orazasyny iman bilen we sogabyny umyt edip tutsa, onuň geçen günäleri bagyşlanar.\"\n— Buhary we Muslim",
  "hadith22": "\"Azan bilen kamatyň arasyndaky doga ret edilmeýär.\"\n— Abu Dawud",
  "hadith23": "\"Kim Alla üçin metjit gursa, Alla oňa jennetde öý gurar.\"\n— Buhary we Muslim",
  "hadith24": "\"Erkekler üçin iň gowy hatarlar — öňki hatarlar, zenanlar üçin iň gowy hatarlar — yzky hatarlardyr.\"\n— Muslim",
  "hadith25": "\"Oraza dowzahdan galkandyr.\"\n— Nesaýy",
  "hadith26": "\"Kim on iki rekagat sünnet namaz okasa, oňa jennetde öý gurulýar.\"\n— Muslim",
  "hadith27": "\"Kurany gowy okaýan belent perişdeler bilen bile bolar.\"\n— Buhary we Muslim",
  "hadith29": "\"Iň gowy sadaka — suw bermekdir.\"\n— Ahmad",
  "hadith30": "\"Kim möminden bir kynçylygy aýyrsa, Alla Kyýamat gününde ondan bir kynçylygy aýyrar.\"\n— Muslim",
  "hadith32": "\"Haýa imanyň bir bölegidir.\"\n— Buhary we Muslim",
  "hadith34": "\"Kim sabyr etse, Alla oňa sabyr berer.\"\n— Buhary we Muslim",
  "hadith36": "\"Siziň hiç biriňiz özi üçin halaýan zadyny doganyna-da halamaýança, hakyky mömin bolmaz.\"\n— Buhary we Muslim",
  "hadith37": "\"Açlary doýuryň, syrkawlaryň halyny soraň we ýesirleri azat ediň.\"\n— Buhary",
  "hadith38": "\"Güýçli adam göreşde ýeňýän däl, eýsem gaharlananda özüne erk edýändir.\"\n— Buhary we Muslim",
  "hadith40": "\"Her namazdan soň otuz üç gezekden 'SubhanAllah', 'Alhamdulillah' we 'Allahu Akbar' diýiň.\"\n— Muslim",
  "hadith41": "\"Iň gowy zikir — La ilähe illallah.\"\n— Tirmizi",
  "hadith42": "\"Iki nygmat bar, köp adam olary biderek geçirýär: saglyk we boş wagt.\"\n— Buhary",
  "hadith43": "\"Bäş zat gelmänkä bäş zadyň gadyryny biliň: garrylykdan öň ýaşlygyňyzyň, keselden öň saglygyňyzyň, garyplykdan öň baýlygyňyzyň, meşgullykdan öň boş wagtyňyzyň we ölümden öň ömrüňiziň.\"\n— Hakim",
  "hadith44": "\"Kim Yhlas süresini on gezek okasa, Alla oňa jennetde öý gurar.\"\n— Ahmad",
  "hadith45": "\"Parz namazlardan soň iň gowy namaz — gije namazydyr.\"\n— Muslim",
  "hadith46": "\"Sadaka günäleri suw ody öçürişi ýaly öçürýär.\"\n— Tirmizi",
  "hadith47": "\"Garyndaşlyk gatnaşygyny saklaýan ýagşylyga ýagşylyk bilen jogap berýän däl, eýsem garyndaşlary ondan aragatnaşygy üzende-de ony saklaýandyr.\"\n— Buhary",
