  "settingsRequestFeature": "Usulkan fitur",
  "settingsSupportFallback": "Tidak dapat membuka aplikasi email. Silakan kirim email ke {email}.",
  "settingsPrivacyPolicy": "Kebijakan Privasi",
  "settingsPrivacyOpenFailed": "Tidak dapat membuka kebijakan privasi.",
  "hadith20": "\"Barangsiapa berpuasa Ramadan karena iman dan mengharap pahala, diampunilah dosa-dosanya yang telah lalu.\"\n— Bukhari & Muslim",
  "hadith22": "\"Doa antara azan dan iqamah tidak ditolak.\"\n— Abu Dawud",
  "hadith23": "\"Barangsiapa membangun masjid karena Allah, Allah akan membangunkan untuknya rumah di surga.\"\n— Bukhari & Muslim",
  "hadith24": "\"Sebaik-baik shaf laki-laki adalah yang pertama, dan sebaik-baik shaf perempuan adalah yang terakhir.\"\n— Muslim",
  "hadith25": "\"Puasa adalah perisai dari api neraka.\"\n— Nasa'i",
  "hadith26": "\"Barangsiapa shalat dua belas rakaat sunnah, dibangunkan untuknya rumah di surga.\"\n— Muslim",
  "hadith27": "\"Orang yang mahir membaca Al-Quran akan bersama para malaikat yang mulia.\"\n— Bukhari & Muslim",
  "hadith29": "\"Sebaik-baik sedekah adalah memberi air minum.\"\n— Ahmad",
  "hadith30": "\"Barangsiapa menghilangkan satu kesusahan dari seorang mukmin, Allah akan menghilangkan satu kesusahan darinya pada Hari Kiamat.\"\n— Muslim",
  "hadith32": "\"Malu adalah bagian dari iman.\"\n— Bukhari & Muslim",
  "hadith34": "\"Barangsiapa bersabar, Allah akan memberinya kesabaran.\"\n— Bukhari & Muslim",
  "hadith36": "\"Tidaklah sempurna iman salah seorang di antara kalian hingga ia mencintai untuk saudaranya apa yang ia cintai untuk dirinya sendiri.\"\n— Bukhari & Muslim",
  "hadith37": "\"Berilah makan orang yang lapar, jenguklah orang yang sakit, dan bebaskanlah tawanan.\"\n— Bukhari",
  "hadith38": "\"Orang yang kuat bukanlah yang pandai bergulat, melainkan yang mampu mengendalikan dirinya saat marah.\"\n— Bukhari & Muslim",
  "hadith40": "\"Ucapkanlah 'SubhanAllah', 'Alhamdulillah', dan 'Allahu Akbar' masing-masing tiga puluh tiga kali setelah setiap shalat.\"\n— Muslim",
  "hadith41": "\"Sebaik-baik dzikir adalah La ilaha illallah.\"\n— Tirmidzi",
  "hadith42": "\"Ada dua nikmat yang sering disia-siakan banyak orang: kesehatan dan waktu luang.\"\n— Bukhari",
  "hadith43": "\"Manfaatkanlah lima sebelum lima: masa muda sebelum tua, sehat sebelum sakit, kaya sebelum miskin, waktu luang sebelum sibuk, dan hidup sebelum mati.\"\n— Hakim",
  "hadith44": "\"Barangsiapa membaca Surah Al-Ikhlas sepuluh kali, Allah akan membangunkan untuknya sebuah rumah di surga.\"\n— Ahmad",
  "hadith45": "\"Shalat terbaik setelah shalat wajib adalah shalat malam.\"\n— Muslim",
  "hadith46": "\"Sedekah memadamkan dosa sebagaimana air memadamkan api.\"\n— Tirmidzi",
  "hadith47": "\"Orang yang menyambung tali silaturahmi bukanlah yang membalas kebaikan, melainkan yang tetap menyambungnya meskipun diputuskan.\"\n— Bukhari",
  "hadith49": "\"Barangsiapa makan lalu berkata: 'Segala puji bagi Allah yang telah memberiku makan ini dan menganugerahkannya tanpa daya dan kekuatan dariku,' maka dosa-dosanya yang lalu akan diampuni.\"\n— Tirmidzi",
  "hadith53": "\"Janganlah meremehkan kebaikan sekecil apa pun, meskipun hanya bertemu saudaramu dengan wajah berseri.\"\n— Muslim",
  "hadith54": "\"Sebaik-baik kalian adalah yang terbaik terhadap keluarganya.\"\n— Tirmidzi",
  "hadith55": "\"Barangsiapa membaca dua ayat terakhir Surah Al-Baqarah pada malam hari, maka itu cukup baginya.\"\n— Bukhari & Muslim",
  "hadith56": "\"Dunia adalah perhiasan, dan sebaik-baik perhiasan adalah istri yang salehah.\"\n— Muslim",
  "hadith57": "\"Tiga doa yang tidak ditolak: doa orang yang berpuasa, pemimpin yang adil, dan orang yang teraniaya.\"\n— Tirmidzi",
  "hadith58": "\"Barangsiapa bershalawat kepadaku sekali, Allah akan bershalawat kepadanya sepuluh kali.\"\n— Muslim",
  "hadith65": "\"Mukmin adalah cermin bagi mukmin lainnya.\"\n— Abu Dawud",
  "hadith66": "\"Kejujuran membawa kepada kebaikan, dan kebaikan membawa kepada surga.\"\n— Bukhari & Muslim",
  "hadith67": "\"Kembalikanlah amanah kepada yang mempercayaimu, dan jangan berkhianat kepada yang mengkhianatimu.\"\n— Abu Dawud & Tirmidzi",
  "hadith68": "\"Tidaklah seorang muslim tertimpa kelelahan, penyakit, kesedihan, kesusahan, gangguan, atau kegelisahan, bahkan tertusuk duri sekalipun, melainkan Allah menghapus sebagian dosanya karenanya.\"\n— Bukhari & Muslim",
  "hadith69": "\"Doa seorang muslim untuk saudaranya tanpa sepengetahuannya selalu dikabulkan.\"\n— Muslim",
  "hadith70": "\"Barangsiapa meminta surga kepada Allah tiga kali, surga berkata: Ya Allah, masukkanlah ia ke surga.\"\n— Tirmidzi",
  "hadith71": "\"Puasa yang paling utama setelah Ramadan adalah puasa di bulan Allah, Muharram.\"\n— Muslim",
  "hadith72": "\"Barangsiapa menunaikan haji dan tidak berkata-kata kotor serta tidak berbuat fasik, maka ia kembali seperti hari ia dilahirkan ibunya.\"\n— Bukhari & Muslim",
  "hadith73": "\"Umrah ke umrah adalah penghapus dosa di antara keduanya.\"\n— Bukhari & Muslim",
  "hadith74": "\"Bersegeralah melakukan amal kebaikan sebelum datang fitnah bagaikan potongan malam yang gelap.\"\n— Muslim",
  "hadith75": "\"Dua rakaat fajar lebih baik daripada dunia dan seisinya.\"\n— Muslim",
  "hadith77": "\"Seandainya kalian bertawakal kepada Allah dengan sebenar-benarnya, niscaya Dia akan memberi kalian rezeki sebagaimana Dia memberi rezeki kepada burung.\"\n— Tirmidzi",
  "hadith78": "\"Barangsiapa menjenguk orang sakit, ia berada di taman surga hingga ia kembali.\"\n— Muslim",
  "hadith79": "\"Sebarkanlah salam, berilah makan, dan shalatlah di malam hari saat orang-orang tidur — kalian akan masuk surga dengan selamat.\"\n— Tirmidzi",
  "hadith80": "\"Barangsiapa tidak berterima kasih kepada manusia, maka ia tidak bersyukur kepada Allah.\"\n— Tirmidzi",
  "hadith81": "\"Tidak boleh iri kecuali dalam dua hal: seseorang yang diberi harta oleh Allah lalu ia membelanjakannya di jalan yang benar, dan seseorang yang diberi hikmah oleh Allah lalu ia memutuskan perkara dengannya dan mengajarkannya.\"\n— Bukhari & Muslim",
  "hadith82": "\"Seseorang itu mengikuti agama temannya, maka hendaklah salah seorang dari kalian melihat siapa yang ia jadikan teman.\"\n— Abu Dawud & Tirmidzi",
  "hadith85": "\"Barangsiapa meninggalkan sesuatu karena Allah, Allah akan menggantinya dengan yang lebih baik.\"\n— Ahmad",
  "hadith86": "\"Barangsiapa menutupi aib seorang muslim, Allah akan menutupi aibnya pada Hari Kiamat.\"\n— Bukhari & Muslim",
  "hadith87": "\"Jadilah di dunia ini seakan-akan engkau orang asing atau musafir.\"\n— Bukhari",
  "hadith88": "\"Barangsiapa memudahkan orang yang dalam kesulitan, Allah akan memudahkannya di dunia dan akhirat.\"\n— Muslim",
  "hadith89": "\"Sesungguhnya setiap amal tergantung pada niatnya.\"\n— Bukhari & Muslim",
  "hadith90": "\"Jauhilah prasangka, karena prasangka adalah ucapan yang paling dusta.\"\n— Bukhari & Muslim",
  "hadith93": "\"Makanlah bersama-sama dan sebutlah nama Allah, niscaya akan diberkahi untuk kalian.\"\n— Abu Dawud",
  "hadith94": "\"Tidak ada kaum yang duduk berdzikir kepada Allah kecuali para malaikat mengelilingi mereka, rahmat meliputi mereka, dan ketenangan turun kepada mereka.\"\n— Muslim",
  "hadith95": "\"Allah tidak menambahkan kepada seorang hamba yang memaafkan kecuali kemuliaan.\"\n— Muslim",
  "hadith96": "\"Ikatlah untamu, kemudian bertawakallah kepada Allah.\"\n— Tirmidzi",
  "hadith97": "\"Sungguh menakjubkan urusan orang beriman — segala sesuatunya baik baginya.\"\n— Muslim",
  "hadith98": "\"Seorang muslim adalah saudara bagi muslim lainnya: ia tidak menzaliminya, tidak meninggalkannya, dan tidak menghinakannya.\"\n— Muslim",
