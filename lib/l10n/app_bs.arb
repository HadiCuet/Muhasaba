  "hadith0": "„Allahu je najdraže ono djelo koje se stalno čini, makar bilo i malo.“\n— Buhari i Muslim",
  "hadith2": "„Kada umre sin Ademov, prestaju mu djela osim triju: trajne sadake, korisnog znanja ili dobrog djeteta koje za njega dovu čini.“\n— Muslim",
  "hadith3": "„Ko klanja dva hladna namaza (sabah i ikindiju), ući će u Džennet.“\n— Buhari",
  "hadith4": "„Allah ne gleda u vaš izgled niti u vaše imetke, nego gleda u vaša srca i vaša djela.“\n— Muslim",
  "hadith6": "„Olakšavajte, a ne otežavajte; obradujte ljude, a ne odbijajte ih.“\n— Buhari",
  "hadith7": "„Ko krene putem tražeći znanje, Allah će mu olakšati put do Dženneta.“\n— Muslim",
  "hadith8": "„Sadaka ne umanjuje imetak.“\n— Muslim",
  "hadith9": "„Jak vjernik bolji je i Allahu draži od slabog vjernika, a u svakom od njih ima dobra.“\n— Muslim",
  "historyDayCompleted": "{completed} od {total} završeno",
  "settingsSchedule": "Raspored",
  "settingsAppearance": "Izgled",
  "settingsAboutTagline": "Vaš svakodnevni pratilac u vjeri",
  "settingsRolloverSub": "Kada počinje novi dan",
  "hadith10": "„Ko stotinu puta dnevno kaže ‚Subhanallahi ve bihamdihi‘, bit će mu oprošteni grijesi, makar ih bilo koliko morske pjene.“\n— Buhari i Muslim",
  "hadith12": "„Ko prouči Ajetul-kursiju nakon svakog farz-namaza, od ulaska u Džennet ne dijeli ga ništa osim smrti.“\n— Nesai",
  "hadith13": "„Lijepa riječ je sadaka.“\n— Buhari i Muslim",
  "hadith14": "„Ko vjeruje u Allaha i Sudnji dan, neka govori dobro ili neka šuti.“\n— Buhari i Muslim",
  "hadith15": "„Onaj ko se brine o udovici ili siromahu je kao borac na Allahovom putu.“\n— Buhari i Muslim",
  "hadith16": "„Tvoj osmijeh tvome bratu je sadaka.“\n— Tirmizi",
  "hadith17": "„Najbolji od vas je onaj ko nauči Kur'an i druge ga podučava.“\n— Buhari",
  "hadith18": "„Niko nije jeo bolju hranu od one koju je zaradio radom svojih ruku.“\n— Buhari",
  "hadith19": "„Allah je blag i voli blagost u svemu.“\n— Buhari i Muslim",
  "settingsAbout": "O aplikaciji",
  "settingsVersion": "Verzija",
  "settingsDeveloper": "Programer",
