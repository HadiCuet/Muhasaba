  "settingsPrivacyPolicy": "سياسة الخصوصية",
  "settingsPrivacyOpenFailed": "تعذّر فتح سياسة الخصوصية.",
  "hadith20": "«مَنْ صَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ.»\n— البخاري ومسلم",
  "hadith22": "«الدُّعَاءُ بَيْنَ الأَذَانِ وَالإِقَامَةِ لا يُرَدُّ.»\n— أبو داود",
  "hadith23": "«مَنْ بَنَى مَسْجِدًا لِلَّهِ بَنَى اللَّهُ لَهُ بَيْتًا فِي الجَنَّةِ.»\n— البخاري ومسلم",
  "hadith24": "«خَيْرُ صُفُوفِ الرِّجَالِ أَوَّلُهَا وَخَيْرُ صُفُوفِ النِّسَاءِ آخِرُهَا.»\n— مسلم",
  "hadith25": "«الصِّيَامُ جُنَّةٌ مِنَ النَّارِ.»\n— النسائي",
  "hadith26": "«مَنْ صَلَّى اثْنَتَيْ عَشْرَةَ رَكْعَةً فِي يَوْمٍ وَلَيْلَةٍ بُنِيَ لَهُ بِهِنَّ بَيْتٌ فِي الجَنَّةِ.»\n— مسلم",
  "hadith27": "«الْمَاهِرُ بِالقُرْآنِ مَعَ السَّفَرَةِ الكِرَامِ البَرَرَةِ.»\n— البخاري ومسلم",
  "hadith29": "«أَفْضَلُ الصَّدَقَةِ سَقْيُ المَاءِ.»\n— أحمد",
  "hadith30": "«مَنْ نَفَّسَ عَنْ مُؤْمِنٍ كُرْبَةً مِنْ كُرَبِ الدُّنْيَا نَفَّسَ اللَّهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ القِيَامَةِ.»\n— مسلم",
  "hadith32": "«الحَيَاءُ شُعْبَةٌ مِنَ الإِيمَانِ.»\n— البخاري ومسلم",
  "hadith34": "«مَنْ يَتَصَبَّرْ يُصَبِّرْهُ اللَّهُ.»\n— البخاري ومسلم",
  "hadith36": "«لا يُؤْمِنُ أَحَدُكُمْ حَتَّى يُحِبَّ لأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ.»\n— البخاري ومسلم",
  "hadith37": "«أَطْعِمُوا الجَائِعَ، وَعُودُوا المَرِيضَ، وَفُكُّوا العَانِيَ.»\n— البخاري",
  "hadith38": "«لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ.»\n— البخاري ومسلم",
  "hadith40": "«تُسَبِّحُونَ دُبُرَ كُلِّ صَلاةٍ ثَلاثًا وَثَلاثِينَ، وَتَحْمَدُونَ ثَلاثًا وَثَلاثِينَ، وَتُكَبِّرُونَ ثَلاثًا وَثَلاثِينَ.»\n— مسلم",
  "hadith41": "«أَفْضَلُ الذِّكْرِ لا إِلَهَ إِلَّا اللَّهُ.»\n— الترمذي",
  "hadith42": "«نِعْمَتَانِ مَغْبُونٌ فِيهِمَا كَثِيرٌ مِنَ النَّاسِ: الصِّحَّةُ وَالفَرَاغُ.»\n— البخاري",
  "hadith43": "«اغْتَنِمْ خَمْسًا قَبْلَ خَمْسٍ: شَبَابَكَ قَبْلَ هَرَمِكَ، وَصِحَّتَكَ قَبْلَ سَقَمِكَ، وَغِنَاكَ قَبْلَ فَقْرِكَ، وَفَرَاغَكَ قَبْلَ شُغْلِكَ، وَحَيَاتَكَ قَبْلَ مَوْتِكَ.»\n— الحاكم",
  "hadith44": "«مَنْ قَرَأَ قُلْ هُوَ اللَّهُ أَحَدٌ عَشْرَ مَرَّاتٍ بَنَى اللَّهُ لَهُ بَيْتًا فِي الجَنَّةِ.»\n— أحمد",
  "hadith45": "«أَفْضَلُ الصَّلاةِ بَعْدَ الفَرِيضَةِ صَلاةُ اللَّيْلِ.»\n— مسلم",
  "hadith46": "«الصَّدَقَةُ تُطْفِئُ الخَطِيئَةَ كَمَا يُطْفِئُ المَاءُ النَّارَ.»\n— الترمذي",
  "hadith47": "«لَيْسَ الوَاصِلُ بِالمُكَافِئِ، وَلَكِنَّ الوَاصِلَ الَّذِي إِذَا قُطِعَتْ رَحِمُهُ وَصَلَهَا.»\n— البخاري",
  "hadith49": "«مَنْ أَكَلَ طَعَامًا فَقَالَ: الحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنِي هَذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلا قُوَّةٍ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ.»\n— الترمذي",
  "hadith53": "«لا تحقرنّ من المعروف شيئًا ولو أن تلقى أخاك بوجه طلق.»\n— مسلم",
  "hadith54": "«خيركم خيركم لأهله.»\n— الترمذي",
  "hadith55": "«من قرأ بالآيتين من آخر سورة البقرة في ليلة كفتاه.»\n— البخاري ومسلم",
  "hadith56": "«الدنيا متاع، وخير متاع الدنيا المرأة الصالحة.»\n— مسلم",
  "hadith57": "«ثلاث دعوات لا تُردّ: دعوة الصائم، ودعوة الإمام العادل، ودعوة المظلوم.»\n— الترمذي",
  "hadith58": "«من صلّى عليّ صلاة واحدة صلّى الله عليه بها عشرًا.»\n— مسلم",
  "hadith65": "«المؤمن مرآة المؤمن.»\n— أبو داود",
  "hadith66": "«إن الصدق يهدي إلى البرّ وإن البرّ يهدي إلى الجنة.»\n— البخاري ومسلم",
  "hadith67": "«أدِّ الأمانة إلى من ائتمنك ولا تخن من خانك.»\n— أبو داود والترمذي",
  "hadith68": "«ما يصيب المسلم من نصب ولا وصب ولا همّ ولا حزن ولا أذى ولا غمّ حتى الشوكة يُشاكها إلا كفّر الله بها من خطاياه.»\n— البخاري ومسلم",
  "hadith69": "«دعوة المرء المسلم لأخيه بظهر الغيب مستجابة.»\n— مسلم",
  "hadith70": "«من سأل الله الجنة ثلاث مرات قالت الجنة: اللهم أدخله الجنة.»\n— الترمذي",
  "hadith71": "«أفضل الصيام بعد رمضان شهر الله المحرّم.»\n— مسلم",
  "hadith72": "«من حجّ لله فلم يرفث ولم يفسق رجع كيوم ولدته أمه.»\n— البخاري ومسلم",
  "hadith73": "«العمرة إلى العمرة كفّارة لما بينهما.»\n— البخاري ومسلم",
  "hadith74": "«بَادِرُوا بِالأَعْمَالِ فِتَنًا كَقِطَعِ اللَّيْلِ المُظْلِمِ.»\n— مسلم",
  "hadith75": "«ركعتا الفجر خير من الدنيا وما فيها.»\n— مسلم",
  "hadith77": "«لو أنكم كنتم توكّلون على الله حقّ توكّله لرزقكم كما يرزق الطير.»\n— الترمذي",
  "hadith78": "«من عاد مريضًا لم يزل في خُرفة الجنة حتى يرجع.»\n— مسلم",
  "hadith79": "«أفشوا السلام، وأطعموا الطعام، وصلّوا بالليل والناس نيام، تدخلوا الجنة بسلام.»\n— الترمذي",
  "hadith80": "«لا يَشْكُرُ اللَّهَ مَنْ لا يَشْكُرُ النَّاسَ.»\n— الترمذي",
  "hadith81": "«لا حسد إلا في اثنتين: رجل آتاه الله مالًا فسلّطه على هلكته في الحق، ورجل آتاه الله الحكمة فهو يقضي بها ويعلّمها.»\n— البخاري ومسلم",
  "hadith82": "«المرء على دين خليله، فلينظر أحدكم من يخالل.»\n— أبو داود والترمذي",
  "hadith85": "«إنك لن تدع شيئًا لله عز وجل إلا بدّلك الله به ما هو خير لك منه.»\n— أحمد",
  "hadith86": "«من ستر مسلمًا ستره الله يوم القيامة.»\n— البخاري ومسلم",
  "hadith87": "«كن في الدنيا كأنك غريب أو عابر سبيل.»\n— البخاري",
  "hadith88": "«من يسّر على معسر يسّر الله عليه في الدنيا والآخرة.»\n— مسلم",
  "hadith89": "«إنما الأعمال بالنيات.»\n— البخاري ومسلم",
  "hadith90": "«إيّاكم والظن فإن الظن أكذب الحديث.»\n— البخاري ومسلم",
  "hadith93": "«اجتمعوا على طعامكم واذكروا اسم الله عليه يُبارَك لكم فيه.»\n— أبو داود",
  "hadith94": "«لا يَقْعُدُ قَوْمٌ يَذْكُرُونَ اللَّهَ إِلَّا حَفَّتْهُمُ المَلائِكَةُ وَغَشِيَتْهُمُ الرَّحْمَةُ وَنَزَلَتْ عَلَيْهِمُ السَّكِينَةُ.»\n— مسلم",
  "hadith95": "«ما زادَ اللهُ عبدًا بعفوٍ إلا عِزًّا.»\n— مسلم",
  "hadith96": "«اعقلها وتوكل.»\n— الترمذي",
  "hadith97": "«عجبًا لأمر المؤمن، إن أمره كله خير.»\n— مسلم",
  "hadith98": "«المسلم أخو المسلم لا يظلمه ولا يخذله ولا يحقره.»\n— مسلم",
