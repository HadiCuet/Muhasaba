# Muhasaba — fastlane
#
# Lanes (iOS):
#   verify  — read-only: confirm the ASC API key authenticates and the app exists
#   beta    — build iOS with Flutter; upload to TestFlight with localized
#             "What's New" when run with upload:true
#
# Lanes (Android):
#   verify     — read-only: confirm the Play service account key authenticates
#   internal   — build the AAB; upload to the Play "internal" testing track
#   production — build the AAB; upload to PRODUCTION with the localized listing,
#                screenshots and changelogs. Staged rollout by default.
#
# Guardrails: nothing uploads without upload:true, and the iOS build is never
# submitted for review or distributed to external testers. The Android
# production lane DOES release to the public — it defaults to a 10% staged
# rollout, and validate:true does a full dry run against Play without
# committing anything.

opt_out_usage
fastlane_version "2.222.0"

APP_IDENTIFIER = "dev.mukashi.muhasaba".freeze
PLAY_PACKAGE_NAME = "dev.mukashi.muhasaba".freeze

# Repo root whether fastlane runs from the repo root or fastlane/.
def repo_root
  pwd = Dir.pwd
  File.basename(pwd) == "fastlane" ? File.expand_path("..", pwd) : pwd
end

# App language code -> App Store Connect locale for TestFlight build "What's New".
# Only ASC-supported locales are valid; everything else falls back to "default".
def whatsnew_locale_map
  {
    "en" => "en-US",
    "ar" => "ar-SA",
    "bn" => "bn-BD",
    "ur" => "ur-PK",
    "id" => "id",
    "tr" => "tr",
    "fr" => "fr-FR",
    "ms" => "ms",
    "hi" => "hi",
  }
end

# Build the upload_to_testflight localized_build_info hash from
# fastlane/whatsnew/<lang>.txt. English seeds the "default" fallback.
def load_localized_whatsnew
  dir = File.join(repo_root, "fastlane", "whatsnew")
  info = {}

  en_path = File.join(dir, "en.txt")
  if File.exist?(en_path)
    text = File.read(en_path).strip
    info["default"] = { whats_new: text } unless text.empty?
  end

  whatsnew_locale_map.each do |lang, asc_locale|
    path = File.join(dir, "#{lang}.txt")
    next unless File.exist?(path)
    text = File.read(path).strip
    next if text.empty?
    info[asc_locale] = { whats_new: text }
  end

  info
end

# Loads the ASC API key into lane_context. Runs as a lane so the action resolves.
private_lane :ensure_api_key do
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH].select { |k| ENV[k].to_s.strip.empty? }
  UI.user_error!("Missing #{missing.join(', ')}. Copy fastlane/.env.example -> fastlane/.env " \
                 "and fill it in (see docs/fastlane-setup.md).") unless missing.empty?

  raw_key_path = ENV["ASC_KEY_FILEPATH"].to_s
  key_path = File.expand_path(raw_key_path, repo_root)
  unless File.exist?(key_path)
    fallback = File.join(repo_root, "fastlane", ".keys", File.basename(raw_key_path))
    key_path = fallback if File.exist?(fallback)
  end
  UI.user_error!("ASC key not found for ASC_KEY_FILEPATH=#{raw_key_path}. " \
                 "Put the .p8 in fastlane/.keys/ (see docs/fastlane-setup.md).") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path,
    in_house: false,
  )
end

platform :ios do
  desc "Read-only: confirm the ASC API key authenticates and the app record exists"
  lane :verify do
    ensure_api_key
    key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key[:key_id], issuer_id: key[:issuer_id], key: key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("Authenticated OK, but no app record for #{APP_IDENTIFIER} on this team. " \
                   "Create the app in App Store Connect first.") if app.nil?
    UI.success("ASC auth OK — app: #{app.name} (id #{app.id})")

    info = load_localized_whatsnew
    UI.message("What's New locales staged: #{info.keys.sort.join(', ')}")
  end

  desc "Read-only: list the locale codes this app actually uses on its App Store version"
  lane :locales do
    ensure_api_key
    key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key[:key_id], issuer_id: key[:issuer_id], key: key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    %i[live edit].each do |which|
      v = which == :live ? app.get_live_app_store_version : app.get_edit_app_store_version
      next unless v
      locs = v.get_app_store_version_localizations.map(&:locale).sort
      UI.header("#{which} version #{v.version_string} — App Store locales")
      UI.message(locs.join(", "))
    end
  end

  desc "Attach localized What's New to the latest processed TestFlight build (no rebuild/upload)"
  lane :notes do
    ensure_api_key
    key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key[:key_id], issuer_id: key[:issuer_id], key: key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    build = app.get_builds(sort: "-uploadedDate", includes: "preReleaseVersion").first
    UI.user_error!("No builds found for #{APP_IDENTIFIER}.") unless build
    UI.message("Latest build: #{build.app_version} (#{build.version})")

    info = load_localized_whatsnew
    existing = build.get_beta_build_localizations.each_with_object({}) { |l, h| h[l.locale] = l }
    info.each do |locale, data|
      next if locale == "default"
      text = data[:whats_new]
      if existing[locale]
        Spaceship::ConnectAPI.patch_beta_build_localizations(
          localization_id: existing[locale].id, attributes: { whatsNew: text },
        )
        UI.success("Updated #{locale}")
      else
        Spaceship::ConnectAPI.post_beta_build_localizations(
          build_id: build.id, attributes: { locale: locale, whatsNew: text },
        )
        UI.success("Created #{locale}")
      end
    end
  end

  desc "Set ONLY the localized 'What's New' (release notes) on the editable App Store version. Touches no other metadata; never submits."
  lane :release_notes do
    ensure_api_key
    key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key[:key_id], issuer_id: key[:issuer_id], key: key[:key],
    )
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    version = app.get_edit_app_store_version
    UI.user_error!("No editable App Store version (Prepare for Submission) found for #{APP_IDENTIFIER}.") unless version
    UI.message("Editable version: #{version.version_string}")

    info = load_localized_whatsnew
    locs = version.get_app_store_version_localizations.each_with_object({}) { |l, h| h[l.locale] = l }
    info.each do |locale, data|
      next if locale == "default"
      loc = locs[locale]
      unless loc
        UI.important("Skipping #{locale} — no App Store localization on this version")
        next
      end
      Spaceship::ConnectAPI.patch_app_store_version_localization(
        app_store_version_localization_id: loc.id, attributes: { whatsNew: data[:whats_new] },
      )
      UI.success("Set What's New for #{locale}")
    end
    UI.success("Done — only 'What's New' was changed on version #{version.version_string}.")
  end


  desc "Push App Store metadata + screenshots to the EDITABLE version. With upload:true. Never submits for review."
  lane :metadata do |options|
    md  = File.join(repo_root, "fastlane", "metadata", "ios")
    sc  = File.join(repo_root, "fastlane", "screenshots")
    UI.user_error!("No metadata at #{md}") unless Dir.exist?(md)
    UI.user_error!("No screenshots at #{sc}") unless Dir.exist?(sc)
    shots = Dir[File.join(sc, "*", "*.png")].count
    UI.message("Staged: #{Dir.children(md).sort.join(', ')} — #{shots} screenshots")

    unless options[:upload]
      UI.important("Dry run — nothing sent. Run: fastlane ios metadata upload:true")
      next
    end

    ensure_api_key
    deliver(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      metadata_path: md,
      screenshots_path: sc,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      precheck_include_in_app_purchases: false,
  )
    UI.success("Metadata + screenshots pushed to the editable version — NOT submitted for review.")
  end

  desc "Build iOS with Flutter; with upload:true upload to TestFlight with localized What's New. Never submits."
  lane :beta do |options|
    Dir.chdir(repo_root) do
      sh("flutter", "build", "ipa", "--release", "--export-method", "app-store")
    end

    ipa = Dir[File.join(repo_root, "build", "ios", "ipa", "*.ipa")].max_by { |f| File.mtime(f) }
    UI.user_error!("No .ipa found under build/ios/ipa/ — did the Flutter build succeed?") unless ipa
    UI.success("Built IPA: #{ipa}")

    info = load_localized_whatsnew
    UI.user_error!("No What's New text found in fastlane/whatsnew/.") if info.empty?

    unless options[:upload]
      UI.important("Build complete — not uploaded.")
      UI.message("What's New locales ready: #{info.keys.sort.join(', ')}")
      UI.message("Run: bundle exec fastlane ios beta upload:true")
      next
    end

    ensure_api_key
    # localized_build_info is applied after the build finishes processing, so we
    # must wait for processing (skip_waiting_for_build_processing: false).
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      ipa: ipa,
      skip_submission: true,
      distribute_external: false,
      skip_waiting_for_build_processing: false,
      localized_build_info: info,
    )
    UI.success("Uploaded to TestFlight with localized What's New — NOT submitted, NOT distributed externally.")
  end
end

# Resolves the Play service account key path and hands it to lane_context.
private_lane :ensure_play_credentials do
  raw_key_path = ENV["PLAY_JSON_KEY_FILEPATH"].to_s
  raw_key_path = "fastlane/.keys/play-service-account.json" if raw_key_path.strip.empty?
  key_path = File.expand_path(raw_key_path, repo_root)
  UI.user_error!("Play service account key not found at #{key_path}. " \
                 "Put the service account JSON at fastlane/.keys/play-service-account.json " \
                 "or set PLAY_JSON_KEY_FILEPATH in fastlane/.env.") unless File.exist?(key_path)
  lane_context[:PLAY_JSON_KEY_PATH] = key_path
end


# Release signing must be present, or Gradle silently produces an AAB Play rejects.
private_lane :ensure_android_signing do
  props = File.join(repo_root, "android", "key.properties")
  unless File.exist?(props)
    UI.user_error!("Missing android/key.properties. Install signing first:\n" \
      "  cp ../muhasaba-screenshots/signing/muhasaba-upload.jks android/\n" \
      "  cp ../muhasaba-screenshots/signing/key.properties android/")
  end
  store = File.read(props)[/storeFile=(.+)/, 1].to_s.strip
  path  = File.expand_path(store, File.join(repo_root, "android"))
  UI.user_error!("key.properties points at #{store}, which does not exist.") unless File.exist?(path)
  UI.success("Release signing present.")
end

platform :android do

  desc "Build the AAB and release to PRODUCTION with the localized listing, screenshots and changelogs. Staged rollout; validate:true for a dry run."
  lane :production do |options|
    ensure_android_signing

    Dir.chdir(repo_root) { sh("flutter", "build", "appbundle", "--release") }
    aab = File.join(repo_root, "build", "app", "outputs", "bundle", "release", "app-release.aab")
    UI.user_error!("No .aab at #{aab} — did the Flutter build succeed?") unless File.exist?(aab)
    UI.success("Built AAB: #{aab} (#{(File.size(aab) / 1_048_576.0).round(1)} MB)")

    md = File.join(repo_root, "fastlane", "metadata", "android")
    locales = Dir.exist?(md) ? Dir.children(md).select { |d| File.directory?(File.join(md, d)) }.sort : []
    shots = Dir[File.join(md, "*", "images", "phoneScreenshots", "*.png")].count
    UI.message("Listing locales: #{locales.empty? ? '(none)' : locales.join(', ')} — #{shots} phone screenshots")

    rollout = (options[:rollout] || "0.1").to_s
    UI.user_error!("rollout must be between 0 and 1 (e.g. 0.1 for 10%)") unless rollout.to_f > 0 && rollout.to_f <= 1

    unless options[:upload]
      UI.important("Dry run — nothing sent to Play.")
      UI.message("Release:   fastlane android production upload:true")
      UI.message("Validate:  fastlane android production upload:true validate:true")
      next
    end

    ensure_play_credentials
    if options[:validate]
      UI.important("VALIDATE ONLY — Play checks the upload and discards it. Nothing is released.")
    else
      UI.important("Releasing to PRODUCTION at #{(rollout.to_f * 100).round}% staged rollout.")
    end

    upload_to_play_store(
      json_key: lane_context[:PLAY_JSON_KEY_PATH],
      package_name: PLAY_PACKAGE_NAME,
      aab: aab,
      track: "production",
      release_status: rollout.to_f >= 1.0 ? "completed" : "inProgress",
      rollout: rollout.to_f >= 1.0 ? nil : rollout,
      metadata_path: md,
      skip_upload_metadata: locales.empty?,
      skip_upload_images: locales.empty?,
      skip_upload_screenshots: locales.empty?,
      skip_upload_changelogs: false,
      validate_only: options[:validate] ? true : false,
      version_codes_to_retain: nil,
    )

    if options[:validate]
      UI.success("Validation passed — Play accepted the upload and discarded it. Nothing released.")
    else
      UI.success("Released to production at #{(rollout.to_f * 100).round}%. " \
                 "Raise it with: fastlane android production upload:true rollout:1.0")
    end
  end
  desc "Read-only: confirm the Play service account key authenticates"
  lane :verify do
    ensure_play_credentials
    validate_play_store_json_key(json_key: lane_context[:PLAY_JSON_KEY_PATH])
    UI.success("Play service account key is valid.")
  end

  desc "Build the AAB with Flutter; with upload:true upload to the Play 'internal' testing track. Never production."
  lane :internal do |options|
    Dir.chdir(repo_root) do
      sh("flutter", "build", "appbundle", "--release")
    end

    aab = File.join(repo_root, "build", "app", "outputs", "bundle", "release", "app-release.aab")
    UI.user_error!("No .aab found at #{aab} — did the Flutter build succeed?") unless File.exist?(aab)
    UI.success("Built AAB: #{aab}")

    unless options[:upload]
      UI.important("Build complete — not uploaded.")
      UI.message("Run: bundle exec fastlane android internal upload:true")
      next
    end

    ensure_play_credentials
    upload_to_play_store(
      json_key: lane_context[:PLAY_JSON_KEY_PATH],
      package_name: PLAY_PACKAGE_NAME,
      aab: aab,
      track: "internal",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
    UI.success("Uploaded to Play Console 'internal' testing track — NOT production, NOT closed/open testing.")
  end
end
